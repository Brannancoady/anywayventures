---
// Cookie banner. Only shown when a tracker is configured in src/data/site.json (analytics.*).
// Nothing non-essential loads until the visitor accepts (UK GDPR / PECR).
interface Props { ga4: string; linkedin: string }
const { ga4, linkedin } = Astro.props;
const enabled = Boolean(ga4 || linkedin);
---
{enabled && (
<div id="consent" data-ga4={ga4} data-linkedin={linkedin} role="dialog" aria-live="polite" aria-label="Cookie choice" hidden style="position:fixed;left:max(12px,env(safe-area-inset-left));right:max(12px,env(safe-area-inset-right));bottom:max(12px,env(safe-area-inset-bottom));z-index:50;max-width:560px;margin-left:auto;background:#15160f;color:#f5f2ea;padding:22px 24px;box-shadow:0 20px 40px -20px rgba(21,22,15,.5)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#d9a27e;margin-bottom:10px">COOKIES</div>
<p style="margin:0 0 16px;font-size:14.5px;line-height:1.55;color:#e4e1d6">We'd like to use Google Analytics{linkedin ? ' and the LinkedIn Insight Tag' : ''} to see which pages are useful. Nothing is loaded unless you accept. <a href="/cookies" style="color:#d9a27e">Details</a></p>
<div style="display:flex;gap:10px;flex-wrap:wrap">
<button type="button" data-consent="granted" style="font:inherit;font-size:14px;font-weight:500;background:#f5f2ea;color:#15160f;border:1px solid #f5f2ea;padding:12px 20px;min-height:44px;cursor:pointer">Accept</button>
<button type="button" data-consent="denied" style="font:inherit;font-size:14px;font-weight:500;background:transparent;color:#f5f2ea;border:1px solid rgba(245,242,234,.5);padding:12px 20px;min-height:44px;cursor:pointer">Decline</button>
</div>
</div>
)}
