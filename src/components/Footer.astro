---
import { contactEmail, mailto, calendarUrl, linkedinUrl, year, companyNo, registeredOffice } from '../lib/data';
---
<footer data-loc="footer" style="padding:clamp(40px,5vw,60px) max(clamp(20px,4vw,60px),env(safe-area-inset-right)) max(28px,env(safe-area-inset-bottom)) max(clamp(20px,4vw,60px),env(safe-area-inset-left));border-top:1px solid rgba(21,22,15,.14)">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:36px 32px">
<div style="grid-column:span 1;min-width:0"><div style="font-family:'Newsreader',Georgia,serif;font-size:22px;letter-spacing:-.01em;margin-bottom:12px">Anyway&nbsp;Ventures</div><p style="margin:0 0 14px;font-size:14px;line-height:1.55;color:#5c5d51;max-width:260px">Capital, board work and hands-on AI for PE-backed and mid-market businesses. Led by Brannan Coady with a small senior bench.</p><a href={mailto} style="text-decoration:none;font-size:14px">{contactEmail}</a></div>
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">FOR PE &amp; INVESTORS</div><div style="display:flex;flex-direction:column;gap:9px"><a href="/private-equity" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Overview</a><a href="/ai-due-diligence" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Tech, product &amp; AI due diligence</a><a href="/ai-operating-partner" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Fractional AI operating partner</a><a href="/board-and-ned" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Board &amp; NED</a></div></div>
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">FOR OPERATORS</div><div style="display:flex;flex-direction:column;gap:9px"><a href="/embedded-ai-delivery" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Embedded AI delivery</a><a href="/how-we-work" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">How we work &amp; pricing</a><a href="/questions" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Questions we get asked</a><a href="/contact" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Book 30 minutes</a></div></div>
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">ABOUT</div><div style="display:flex;flex-direction:column;gap:9px"><a href="/brannan-coady" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Brannan Coady</a><a href="/track-record" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Investments &amp; exits</a><a href="/case-studies" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Case studies</a><a href="/insights" style="text-decoration:none;color:#3c3d33;font-size:14px;line-height:1.4">Insights</a></div></div>
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">CONTACT</div><div style="display:flex;flex-direction:column;gap:9px"><a href={mailto} style="text-decoration:none;color:#3c3d33;font-size:14px">Email</a><a href={calendarUrl} style="text-decoration:none;color:#3c3d33;font-size:14px">Book 30 minutes</a><a href={linkedinUrl} target="_blank" rel="noreferrer" style="text-decoration:none;color:#3c3d33;font-size:14px">LinkedIn</a><span style="color:#5c5d51;font-size:14px;line-height:1.4">York, United Kingdom<br>Working UK-wide</span></div></div>
</div>
<div style="margin-top:40px;padding-top:20px;border-top:1px solid rgba(21,22,15,.12);display:flex;justify-content:space-between;align-items:center;gap:14px 30px;flex-wrap:wrap;font-size:12.5px;color:#5c5d51">
<span>© {year} Anyway Ventures Ltd. Registered in England &amp; Wales, company no. {companyNo}. Registered office: {registeredOffice}.</span>
<div style="display:flex;gap:20px;flex-wrap:wrap"><a href="/privacy" style="text-decoration:none;color:#5c5d51">Privacy</a><a href="/terms" style="text-decoration:none;color:#5c5d51">Terms of engagement</a><a href="/cookies" style="text-decoration:none;color:#5c5d51">Cookies</a><button type="button" data-consent-open style="font:inherit;background:none;border:0;padding:0;cursor:pointer;color:#5c5d51">Cookie settings</button></div>
</div>
</footer>
