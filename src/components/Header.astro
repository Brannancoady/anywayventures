---
import { getPosts, linkedinUrl } from '../lib/data';

interface Props { path: string }
const { path } = Astro.props;

const on = '#8a5a3c', off = '#4a4b40';
const pePages = ['/private-equity', '/ai-due-diligence', '/ai-operating-partner', '/board-and-ned'].includes(path);
const opsPages = path === '/embedded-ai-delivery';
const aboutPages = ['/brannan-coady', '/track-record', '/case-studies'].includes(path);
const insightPages = path.startsWith('/insights');
const cPe = pePages ? on : off, cOperators = opsPages ? on : off, cAboutMenu = aboutPages ? on : off, cInsights = insightPages ? on : off;
const uPe = pePages ? on : 'transparent', uOps = opsPages ? on : 'transparent', uAbout = aboutPages ? on : 'transparent';

const posts = await getPosts();
const bySlug = (slug: string) => posts.find((p) => p.slug === slug) ?? posts[0];
const featPe = bySlug('ai-due-diligence-private-equity');
const featOps = bySlug('why-ai-pilots-fail');
const featAbout = bySlug('ai-operating-partner-private-equity');
const drawerFeatured = featPe;

const drawerGroups = [
  { heading: 'FOR PE & INVESTORS', items: [
    { label: 'Overview', sub: 'The deal cycle', href: '/private-equity' },
    { label: 'Tech, product & AI due diligence', sub: '1–3 wks', href: '/ai-due-diligence' },
    { label: 'Fractional AI operating partner', sub: 'Retained', href: '/ai-operating-partner' },
    { label: 'Board & NED', sub: '2–4 seats', href: '/board-and-ned' } ] },
  { heading: 'FOR OPERATORS', items: [
    { label: 'Embedded AI delivery', sub: '2–8 wks', href: '/embedded-ai-delivery' },
    { label: 'How we work & pricing', sub: '', href: '/how-we-work' },
    { label: 'Questions we get asked', sub: '', href: '/questions' } ] },
  { heading: 'ABOUT', items: [
    { label: 'Brannan Coady', sub: '', href: '/brannan-coady' },
    { label: 'Investments & exits', sub: '', href: '/track-record' },
    { label: 'Case studies', sub: '', href: '/case-studies' } ] },
];
---
<header id="site-header" data-loc="nav" style="position:sticky;top:0;z-index:30;background:#f5f2ea;border-bottom:1px solid rgba(21,22,15,.14);padding-top:env(safe-area-inset-top)">
<div class="hdr-row" style="display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px max(clamp(20px,4vw,60px),env(safe-area-inset-right)) 14px max(clamp(20px,4vw,60px),env(safe-area-inset-left))">
<a href="/" class="wordmark" style="text-decoration:none;color:#15160f;font-family:'Newsreader',Georgia,serif;font-size:23px;letter-spacing:-.01em;white-space:nowrap">Anyway&nbsp;Ventures</a>
<nav aria-label="Main" class="only-desktop" style="display:flex;align-items:center;gap:clamp(14px,2vw,28px);font-size:14px;flex-wrap:wrap">
<a href="/private-equity" data-menu="pe" aria-controls="menu-pe" aria-expanded="false" style={`text-decoration:none;color:${cPe};padding:6px 0;border-bottom:1px solid ${uPe}`}>For PE &amp; investors</a>
<a href="/embedded-ai-delivery" data-menu="ops" aria-controls="menu-ops" aria-expanded="false" style={`text-decoration:none;color:${cOperators};padding:6px 0;border-bottom:1px solid ${uOps}`}>For operators</a>
<a href="/brannan-coady" data-menu="about" aria-controls="menu-about" aria-expanded="false" style={`text-decoration:none;color:${cAboutMenu};padding:6px 0;border-bottom:1px solid ${uAbout}`}>About</a>
<a href="/insights" style={`text-decoration:none;color:${cInsights};padding:6px 0;border-bottom:1px solid transparent`}>Insights</a>
<a href="/contact" style="text-decoration:none;color:#f5f2ea;background:#15160f;padding:10px 18px;font-size:13.5px;font-weight:500">Enquire</a>
</nav>
<div class="only-compact" style="display:flex;align-items:center;gap:12px">
<a href="/contact" style="text-decoration:none;color:#f5f2ea;background:#15160f;padding:12px 16px;font-size:13.5px;font-weight:500;min-height:44px;display:flex;align-items:center">Enquire</a>
<button type="button" id="drawer-toggle" aria-controls="drawer" aria-expanded="false" aria-label="Menu" style="text-decoration:none;color:#15160f;border:1px solid rgba(21,22,15,.3);min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;padding:0 14px;background:transparent;cursor:pointer">MENU</button>
</div>
</div>
<div id="menu-pe" class="megamenu" hidden style="border-top:1px solid rgba(21,22,15,.14);background:#f5f2ea;box-shadow:0 24px 40px -24px rgba(21,22,15,.25)">
<div style="display:grid;grid-template-columns:minmax(0,2.3fr) minmax(260px,1fr)">
<div style="padding:34px clamp(20px,4vw,60px) 38px;border-right:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:minmax(180px,240px) minmax(0,1fr);gap:40px">
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">FOR PE &amp; INVESTORS</div><p style="margin:0;font-size:14.5px;line-height:1.55;color:#3c3d33">One partner across the deal cycle: the person who diligences the target writes the AI plan and helps the portfolio deliver it.</p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 36px"><div><a href="/ai-due-diligence" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Tech, product &amp; AI due diligence</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Pre-deal · 1–3 weeks · fixed price</div></a><a href="/ai-operating-partner" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Fractional AI operating partner</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Retained · across the portfolio</div></a></div><div><a href="/board-and-ned" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Board &amp; NED</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Governance · 2–4 seats held</div></a><a href="/private-equity" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">The whole deal cycle</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">How the four fit together</div></a></div></div>
</div>
<a href={featPe.href} style="text-decoration:none;color:#f5f2ea;background:#15160f;padding:34px clamp(20px,3vw,44px) 38px;display:flex;flex-direction:column;gap:14px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#d9a27e">FROM INSIGHTS · {featPe.kicker}</div>
<div style="font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:26px;line-height:1.15;letter-spacing:-.015em">{featPe.title}</div>
<div style="font-size:14.5px;line-height:1.55;color:#c5c4b4">{featPe.standfirst}</div>
<div style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:#d9a27e">READ · {featPe.read} →</div>
</a>
</div>
</div>
<div id="menu-ops" class="megamenu" hidden style="border-top:1px solid rgba(21,22,15,.14);background:#f5f2ea;box-shadow:0 24px 40px -24px rgba(21,22,15,.25)">
<div style="display:grid;grid-template-columns:minmax(0,2.3fr) minmax(260px,1fr)">
<div style="padding:34px clamp(20px,4vw,60px) 38px;border-right:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:minmax(180px,240px) minmax(0,1fr);gap:40px">
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">FOR OPERATORS</div><p style="margin:0;font-size:14.5px;line-height:1.55;color:#3c3d33">For CEOs and owner-managers who want cost out and capability in — built with your team, not described to them.</p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 36px"><div><a href="/embedded-ai-delivery" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Embedded AI delivery</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Inside the business · 2–8 weeks</div></a><a href="/embedded-ai-delivery" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Internal tooling &amp; automation</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Agents in production, owned by your team</div></a></div><div><a href="/embedded-ai-delivery" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Capability transfer</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Your people, AI-native for real</div></a><a href="/contact" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Book the first conversation</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Free · under an hour · straight answer on fit</div></a></div></div>
</div>
<a href={featOps.href} style="text-decoration:none;color:#f5f2ea;background:#15160f;padding:34px clamp(20px,3vw,44px) 38px;display:flex;flex-direction:column;gap:14px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#d9a27e">FROM INSIGHTS · {featOps.kicker}</div>
<div style="font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:26px;line-height:1.15;letter-spacing:-.015em">{featOps.title}</div>
<div style="font-size:14.5px;line-height:1.55;color:#c5c4b4">{featOps.standfirst}</div>
<div style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:#d9a27e">READ · {featOps.read} →</div>
</a>
</div>
</div>
<div id="menu-about" class="megamenu" hidden style="border-top:1px solid rgba(21,22,15,.14);background:#f5f2ea;box-shadow:0 24px 40px -24px rgba(21,22,15,.25)">
<div style="display:grid;grid-template-columns:minmax(0,2.3fr) minmax(260px,1fr)">
<div style="padding:34px clamp(20px,4vw,60px) 38px;border-right:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:minmax(180px,240px) minmax(0,1fr);gap:40px">
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:14px">ABOUT</div><p style="margin:0;font-size:14.5px;line-height:1.55;color:#3c3d33">A founder-operator’s vehicle: capital, board work, and hands-on AI — with a small senior bench behind it.</p></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 36px"><div><a href="/brannan-coady" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Brannan Coady</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Operating experience: Netsells, YourParkingSpace, exits</div></a><a href="/track-record" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Investments &amp; exits</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Companies founded, backed and sold</div></a></div><div><a href="/case-studies" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">Case studies</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Recent client work, with numbers</div></a><a href="/brannan-coady" style="text-decoration:none;color:#15160f;display:block;padding:12px 0;border-top:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">The bench</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Engineering, data, security, design</div></a></div></div>
</div>
<a href={featAbout.href} style="text-decoration:none;color:#f5f2ea;background:#15160f;padding:34px clamp(20px,3vw,44px) 38px;display:flex;flex-direction:column;gap:14px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#d9a27e">FROM INSIGHTS · {featAbout.kicker}</div>
<div style="font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:26px;line-height:1.15;letter-spacing:-.015em">{featAbout.title}</div>
<div style="font-size:14.5px;line-height:1.55;color:#c5c4b4">{featAbout.standfirst}</div>
<div style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:#d9a27e">READ · {featAbout.read} →</div>
</a>
</div>
</div>
<nav id="drawer" aria-label="Menu" class="drawer" data-loc="drawer" hidden style="border-top:1px solid rgba(21,22,15,.14);background:#f5f2ea;max-height:calc(100dvh - 73px);overflow-y:auto;padding:8px max(clamp(20px,4vw,60px),env(safe-area-inset-right)) max(28px,env(safe-area-inset-bottom)) max(clamp(20px,4vw,60px),env(safe-area-inset-left))">
{drawerGroups.map((g) => (<Fragment>
<div style="padding:18px 0 6px;border-bottom:1px solid rgba(21,22,15,.12)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:6px">{g.heading}</div>
{g.items.map((it) => (<Fragment>
<a href={it.href} style="text-decoration:none;color:#15160f;display:flex;justify-content:space-between;align-items:center;gap:12px;min-height:48px;padding:6px 0"><span style="font-family:'Newsreader',Georgia,serif;font-size:21px;line-height:1.2">{it.label}</span><span style="font-size:12.5px;color:#5c5d51;text-align:right;flex:none">{it.sub}</span></a>
</Fragment>))}
</div>
</Fragment>))}
<div style="display:flex;flex-wrap:wrap;gap:10px 22px;padding-top:18px;font-size:14px"><a href="/insights" style="text-decoration:none;color:#3c3d33;min-height:44px;display:flex;align-items:center">Insights</a><a href="/contact" style="text-decoration:none;color:#3c3d33;min-height:44px;display:flex;align-items:center">Contact</a><a href={linkedinUrl} target="_blank" rel="noreferrer" style="text-decoration:none;color:#3c3d33;min-height:44px;display:flex;align-items:center">LinkedIn</a></div>
<a href={drawerFeatured.href} style="text-decoration:none;color:#f5f2ea;background:#15160f;padding:22px 24px;display:flex;flex-direction:column;gap:8px;margin-top:8px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#d9a27e">FROM INSIGHTS</div><div style="font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:22px;line-height:1.2">{drawerFeatured.title}</div><div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;color:#d9a27e">READ · {drawerFeatured.read} →</div></a>
</nav>
</header>
