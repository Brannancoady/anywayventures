---
import Base from '../layouts/Base.astro';
import { cases, record } from '../lib/data';

const path = '/track-record';
---
<Base path={path}>
<div>
<div style="padding:clamp(48px,7vw,80px) clamp(20px,4vw,60px) clamp(40px,5vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;color:#8a5a3c;margin-bottom:30px">TRACK RECORD</div>
<h1 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(38px,5.4vw,72px);line-height:1.04;letter-spacing:-.025em;max-width:16ch;text-wrap:balance">Built, backed, and <em style="color:#8a5a3c">in some cases sold</em>.</h1>
<p style="margin:34px 0 0;font-size:19px;line-height:1.62;color:#3c3d33;max-width:700px;text-wrap:pretty">The companies founded and operated, the investments and board positions held, and recent client work. The capital side of Anyway Ventures still runs — small personal cheques into early UK software and consumer businesses, usually with time attached.</p>
</div>

<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<h2 style="margin:0 0 28px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:36px;letter-spacing:-.02em">Companies &amp; positions</h2>
<div class="r-rec" style="display:grid;gap:12px 20px;padding-bottom:12px;border-bottom:1px solid rgba(21,22,15,.3);font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#5c5d51"><span>COMPANY</span><span>ROLE</span><span>SECTOR</span><span style="text-align:right">STATUS</span></div>
{record.map((row, i) => (<Fragment>
{(i === 0 || record[i - 1].group !== row.group) && <h3 style="margin:34px 0 4px;font-family:'IBM Plex Mono',monospace;font-weight:400;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c;text-transform:uppercase">{row.group}</h3>}
<div class="r-rec" style="display:grid;gap:12px 20px;padding:19px 0;border-bottom:1px solid rgba(21,22,15,.12);font-size:15px;align-items:baseline"><span style="font-family:'Newsreader',Georgia,serif;font-size:20px">{row.name}</span><span style="color:#3c3d33">{row.role}</span><span style="color:#5c5d51">{row.sector}</span><span style={`text-align:right;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.1em;color:${row.colour}`}>{row.status}</span></div>
</Fragment>))}
<p style="margin:22px 0 0;font-size:13.5px;color:#5c5d51;font-family:'IBM Plex Mono',monospace;letter-spacing:.04em">Also an investor in Boltbar, Supercycle, Ad-MOTO, Clays and IMPOSSIBREW.</p>
</div>

<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);background:#eeeade">
<h2 style="margin:0 0 30px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:36px;letter-spacing:-.02em">Recent client work</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
{cases.map((c) => (<Fragment>
<div style="border:1px solid rgba(21,22,15,.16);background:#f5f2ea;padding:30px 28px;display:flex;flex-direction:column;gap:14px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#8a5a3c">{c.tag}</div>
<h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:24px;line-height:1.18">{c.title}</h3>
<p style="margin:0;font-size:15px;line-height:1.6;color:#3c3d33">{c.body}</p>
<div style="margin-top:auto;padding-top:18px;border-top:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:1fr 1fr;gap:16px">
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:30px;font-weight:300;letter-spacing:-.02em">{c.stat1}</div><div style="font-size:12.5px;color:#5c5d51;line-height:1.4">{c.label1}</div></div>
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:30px;font-weight:300;letter-spacing:-.02em">{c.stat2}</div><div style="font-size:12.5px;color:#5c5d51;line-height:1.4">{c.label2}</div></div>
</div>
</div>
</Fragment>))}
</div>
<p style="margin:18px 0 0;font-size:12.5px;color:#8a5a3c;font-family:'IBM Plex Mono',monospace;letter-spacing:.04em">Figures illustrative pending client sign-off — replace before publication.</p>
</div>

<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);display:flex;flex-wrap:wrap;justify-content:space-between;gap:28px 40px;align-items:center">
<div><h2 style="margin:0 0 12px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:34px;letter-spacing:-.02em">Raising?</h2><p style="margin:0;font-size:17px;line-height:1.6;color:#3c3d33;max-width:560px">UK, early, software-shaped, founders who ship, and a real use for the time as well as the money. Send the deck and one paragraph on why now — I reply either way.</p></div>
<a href="/contact" style="flex:none;text-decoration:none;background:#15160f;color:#f5f2ea;padding:14px 28px;min-height:48px;display:inline-flex;align-items:center;font-size:15px;font-weight:500">Send it over</a>
</div>
</div>
</Base>
