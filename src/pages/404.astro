---
import Base from '../layouts/Base.astro';

const path = '/404';
---
<Base path={path}>
<div>
<div style="padding:clamp(60px,9vw,110px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;color:#8a5a3c;margin-bottom:28px">404 · NOT FOUND</div>
<h1 style="margin:0 0 24px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(36px,5vw,64px);line-height:1.05;letter-spacing:-.025em;max-width:16ch;text-wrap:balance">That page has been <em style="color:#8a5a3c">handed over</em>, or never built.</h1>
<p style="margin:0 0 34px;font-size:18px;line-height:1.65;color:#3c3d33;max-width:560px">The site was restructured recently, so older links may have moved. Here's where most people are heading.</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:1px;border:1px solid rgba(21,22,15,.16)">
<a href="/private-equity" style="text-decoration:none;color:#15160f;outline:1px solid rgba(21,22,15,.16);padding:22px 20px;min-height:48px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px">For PE &amp; investors</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Diligence, operating partner, board</div></a>
<a href="/embedded-ai-delivery" style="text-decoration:none;color:#15160f;outline:1px solid rgba(21,22,15,.16);padding:22px 20px;min-height:48px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px">For operators</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Embedded AI delivery</div></a>
<a href="/track-record" style="text-decoration:none;color:#15160f;outline:1px solid rgba(21,22,15,.16);padding:22px 20px;min-height:48px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px">Track record</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Investments, exits, client work</div></a>
<a href="/contact" style="text-decoration:none;color:#15160f;outline:1px solid rgba(21,22,15,.16);padding:22px 20px;min-height:48px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px">Contact</div><div style="font-size:13px;color:#5c5d51;margin-top:3px">Book 30 minutes</div></a>
</div>
</div>
</div>
</Base>
