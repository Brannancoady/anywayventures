---
import Base from '../../layouts/Base.astro';
import { getPosts } from '../../lib/data';

const path = '/insights';
const posts = await getPosts();
---
<Base path={path}>
<div>
<div style="padding:clamp(48px,7vw,80px) clamp(20px,4vw,60px) clamp(40px,5vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;color:#8a5a3c;margin-bottom:30px">INSIGHTS</div>
<h1 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(38px,5.4vw,72px);line-height:1.04;letter-spacing:-.025em;max-width:16ch;text-wrap:balance">Writing for deal teams and <em style="color:#8a5a3c">operators</em>.</h1>
<p style="margin:34px 0 0;font-size:19px;line-height:1.62;color:#3c3d33;max-width:660px">Short and practical. Written from the work, not about it. No newsletter — if you want to hear when something new goes up, LinkedIn is where it lands.</p>
</div>
<div style="padding:clamp(30px,4vw,50px) clamp(20px,4vw,60px) clamp(46px,6vw,70px);border-bottom:1px solid rgba(21,22,15,.14)">
{posts.map((p) => (<Fragment>
<a href={p.href} style="text-decoration:none;color:#15160f;display:grid;grid-template-columns:minmax(120px,160px) minmax(0,1fr);gap:28px;padding:30px 0;border-top:1px solid rgba(21,22,15,.18);align-items:start"><div><div style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8a5a3c;letter-spacing:.1em;margin-bottom:6px">{p.kicker}</div><div style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#5c5d51;letter-spacing:.06em">{p.date} · {p.read}</div></div><div><h2 style="margin:0 0 10px;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:30px;line-height:1.15;letter-spacing:-.015em">{p.title}</h2><p style="margin:0;font-size:16px;line-height:1.6;color:#3c3d33;max-width:700px">{p.standfirst}</p></div></a>
</Fragment>))}
<div style="border-top:1px solid rgba(21,22,15,.18)"></div>
</div>
</div>
</Base>
