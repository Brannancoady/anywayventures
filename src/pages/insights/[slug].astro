---
import Portrait from '../../components/Portrait.astro';
import Base from '../../layouts/Base.astro';
import { getPosts, type Post } from '../../lib/data';
import { marked } from 'marked';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((p) => ({ params: { slug: p.slug }, props: { p, posts } }));
}

const { p, posts } = Astro.props as { p: Post; posts: Post[] };
const path = '/insights';

// Article body is Markdown. First paragraph is the lead, the pull quote sits after the second.
const tokens = marked.lexer(p.body).filter((t) => t.type !== 'space');
const html = (t: (typeof tokens)[number]) =>
  t.type === 'paragraph' ? (marked.parseInline(t.text) as string) : (marked.parser([t] as any) as string);
const blocks = tokens.map((t) => ({ p: t.type === 'paragraph', html: html(t) }));
const words = p.body.replace(/[#*_>`\[\]()-]/g, ' ').split(/\s+/).filter(Boolean).length;

const post = {
  ...p,
  dateLong: p.published.toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
  lead: blocks[0]?.html ?? '',
  bodyA: blocks.slice(1, 2),
  bodyB: blocks.slice(2),
  related: relatedPosts(),
};

// Up to three related pieces: hand-picked first, then the same service, then the most recent.
function relatedPosts() {
  const others = posts.filter((x) => x.slug !== p.slug);
  const picked = p.related.map((s) => others.find((x) => x.slug === s)).filter((x): x is Post => !!x);
  const rest = [...others.filter((x) => x.service === p.service), ...others].filter((x) => !picked.includes(x));
  return [...new Set([...picked, ...rest])].slice(0, 3);
}

const article = {
  title: p.title,
  description: p.description ?? p.standfirst,
  path: p.href,
  published: p.published,
  updated: p.updated,
  wordCount: words,
  section: p.kicker.charAt(0) + p.kicker.slice(1).toLowerCase(),
  about: p.service,
  image: p.image,
  tags: p.tags,
  faq: p.faq,
};
---
<Base path={path} article={article} ctaHeading="Talk about this piece.">
<div>
<div style="background:#eeeade;border-bottom:1px solid rgba(21,22,15,.14);padding:clamp(40px,6vw,72px) clamp(20px,4vw,60px) clamp(40px,5vw,60px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:clamp(28px,5vw,80px);align-items:end">
<div>
<a href="/insights" style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-decoration:none;white-space:nowrap">← ALL WRITING</a>
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin:32px 0 20px">{post.kicker}</div>
<h1 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(36px,5vw,66px);line-height:1.04;letter-spacing:-.025em;max-width:20ch;text-wrap:balance">{post.title}</h1>
<p style="margin:26px 0 0;font-family:'Newsreader',Georgia,serif;font-style:italic;font-size:clamp(20px,2vw,25px);line-height:1.4;color:#3c3d33;max-width:34ch;text-wrap:pretty">{post.standfirst}</p>
</div>
<div style="display:flex;flex-direction:column;gap:14px;padding-top:22px;border-top:1px solid rgba(21,22,15,.25)">
<div style="display:flex;justify-content:space-between;gap:16px;font-size:13.5px"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#5c5d51">WRITTEN</span><time datetime={post.published.toISOString().slice(0, 10)} style="color:#15160f">{post.dateLong}</time></div>
<div style="display:flex;justify-content:space-between;gap:16px;font-size:13.5px"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#5c5d51">READING</span><span style="color:#15160f">{post.readLong}</span></div>
<div style="display:flex;justify-content:space-between;gap:16px;font-size:13.5px"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#5c5d51">FOR</span><span style="color:#15160f;text-align:right">{post.audience}</span></div>
<div style="display:flex;justify-content:space-between;gap:16px;font-size:13.5px"><span style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#5c5d51">RELATES TO</span><a href={post.serviceHref} style="text-decoration:none;text-align:right">{post.service}</a></div>
</div>
</div>

<div style="padding:clamp(40px,6vw,72px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:minmax(0,1fr) minmax(0,680px) minmax(0,1fr);gap:0 clamp(0px,4vw,60px)">
<div></div>
<article data-article={post.slug} style="min-width:0">
<p style="margin:0 0 24px;font-size:20px;line-height:1.6;color:#15160f" set:html={post.lead}></p>
{post.bodyA.map((para) => (<Fragment>
{para.p ? <p style="margin:0 0 22px;font-size:17.5px;line-height:1.72;color:#15160f" set:html={para.html}></p> : <div class="prose-block" style="font-size:17.5px;line-height:1.72;color:#15160f;margin:0 0 22px" set:html={para.html} />}
</Fragment>))}
<blockquote style="margin:38px 0;padding:0 0 0 26px;border-left:2px solid #8a5a3c;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(24px,2.4vw,30px);line-height:1.3;letter-spacing:-.01em;color:#15160f">{post.pull}</blockquote>
{post.bodyB.map((para) => (<Fragment>
{para.p ? <p style="margin:0 0 22px;font-size:17.5px;line-height:1.72;color:#15160f" set:html={para.html}></p> : <div class="prose-block" style="font-size:17.5px;line-height:1.72;color:#15160f;margin:0 0 22px" set:html={para.html} />}
</Fragment>))}
{post.faq.length > 0 && (
<section aria-labelledby="faq-heading" style="margin-top:48px">
<h2 id="faq-heading" style="margin:0 0 6px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:30px;letter-spacing:-.02em">Questions</h2>
{post.faq.map((f) => (
<div style="padding:22px 0;border-top:1px solid rgba(21,22,15,.16)">
<h3 style="margin:0 0 8px;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:21px;line-height:1.25">{f.q}</h3>
<p style="margin:0;font-size:16.5px;line-height:1.68;color:#3c3d33">{f.a}</p>
</div>
))}
</section>
)}
<div style="margin-top:44px;padding:26px 28px;border:1px solid rgba(21,22,15,.16);display:grid;grid-template-columns:72px minmax(0,1fr);gap:22px;align-items:center">
<Portrait avatar />
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:21px;margin-bottom:4px">Brannan Coady</div><div style="font-size:14.5px;line-height:1.5;color:#3c3d33">Founder of Anyway Ventures. Exited founder, former CEO of YourParkingSpace, investor and board member; now building AI inside PE-backed and mid-market businesses. <a href="/brannan-coady" style="text-decoration:underline;text-underline-offset:3px">More →</a></div></div>
</div>
</article>
<div style="display:none"></div>
</div>

<div style="padding:clamp(40px,5vw,60px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);background:#eeeade">
<div style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:24px"><h2 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:32px;letter-spacing:-.02em">Keep reading</h2><a href="/insights" style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.14em;text-decoration:none;white-space:nowrap">ALL WRITING →</a></div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
{post.related.map((r) => (<Fragment>
<a href={r.href} style="text-decoration:none;color:#15160f;background:#f5f2ea;border:1px solid rgba(21,22,15,.16);padding:26px 28px;display:flex;flex-direction:column;gap:10px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#8a5a3c">{r.kicker} · {r.read}</div><div style="font-family:'Newsreader',Georgia,serif;font-size:23px;line-height:1.2">{r.title}</div><div style="font-size:14.5px;line-height:1.55;color:#5c5d51">{r.standfirst}</div></a>
</Fragment>))}
</div>
</div>
</div>
</Base>
