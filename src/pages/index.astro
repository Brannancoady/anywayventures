---
import Portrait from '../components/Portrait.astro';
import Base from '../layouts/Base.astro';
import { getLatestByService, cases } from '../lib/data';

const path = '/';
const posts = await getLatestByService(3);
---
<Base path={path}>
<div>
<div style="padding:clamp(48px,7vw,84px) clamp(20px,4vw,60px) 0">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;color:#8a5a3c;margin-bottom:30px">AI OPERATING PARTNER · DUE DILIGENCE · EMBEDDED DELIVERY · BOARD</div>
<h1 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(40px,6vw,80px);line-height:1.02;letter-spacing:-.025em;max-width:17ch;text-wrap:balance">The AI operating partner for <em style="color:#8a5a3c">PE-backed and mid-market</em> businesses.</h1>
<div style="display:flex;flex-direction:column;gap:30px;margin-top:40px;align-items:flex-start;padding-bottom:52px;border-bottom:1px solid rgba(21,22,15,.14)">
<p style="margin:0;font-size:20px;line-height:1.6;color:#3c3d33;max-width:700px;text-wrap:pretty">Anyway Ventures is the vehicle of Brannan Coady — founder, exited operator and investor — and a small senior bench. We diligence technology and AI before a deal, plan AI value creation across a portfolio, and go into companies to build it with their teams. Not slideware: internal tooling, automation and agents in production.</p>
<div style="display:flex;flex-wrap:wrap;gap:12px;align-self:stretch">
<a href="/private-equity" style="flex:none;white-space:nowrap;text-decoration:none;background:#15160f;color:#f5f2ea;padding:14px 24px;min-height:48px;display:inline-flex;align-items:center;font-size:15px;font-weight:500">For PE &amp; investors</a>
<a href="/embedded-ai-delivery" style="flex:none;white-space:nowrap;text-decoration:none;border:1px solid rgba(21,22,15,.3);color:#15160f;padding:14px 24px;min-height:48px;display:inline-flex;align-items:center;font-size:15px;font-weight:500">For CEOs &amp; owner-managers</a>
</div>
</div>
</div>

<div style="padding:0 clamp(20px,4vw,60px);display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));border-bottom:1px solid rgba(21,22,15,.14)">
<div style="padding:30px 26px 30px 0"><div style="font-family:'Newsreader',Georgia,serif;font-size:42px;font-weight:300;letter-spacing:-.02em">12<span style="color:#8a5a3c">yrs</span></div><div style="font-size:13.5px;color:#5c5d51;line-height:1.45;margin-top:4px">building and selling software businesses</div></div>
<div style="padding:30px 26px;border-left:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:42px;font-weight:300;letter-spacing:-.02em">2</div><div style="font-size:13.5px;color:#5c5d51;line-height:1.45;margin-top:4px">consultancies founded, both realised</div></div>
<div style="padding:30px 26px;border-left:1px solid rgba(21,22,15,.12)"><div style="font-family:'Newsreader',Georgia,serif;font-size:42px;font-weight:300;letter-spacing:-.02em">9</div><div style="font-size:13.5px;color:#5c5d51;line-height:1.45;margin-top:4px">investments and board positions held</div></div>
<div style="padding:30px 0 30px 26px;border-left:1px solid rgba(21,22,15,.12)"><div style="font-family:'IBM Plex Mono',monospace;font-size:15px;letter-spacing:.1em;color:#8a5a3c;border:1px dashed rgba(138,90,60,.5);padding:10px 12px;display:inline-block">FIGURE TBC</div><div style="font-size:13.5px;color:#5c5d51;line-height:1.45;margin-top:8px">value of exits to FTSE 100 acquirers</div></div>
</div>

<div style="padding:clamp(46px,6vw,74px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:12px">I. FOR PE &amp; INVESTORS</div>
<h2 style="margin:0 0 10px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:38px;line-height:1.1;letter-spacing:-.02em;max-width:700px">One partner across the deal cycle</h2>
<p style="margin:0 0 36px;font-size:16px;color:#5c5d51;max-width:640px">The same person who diligences the target writes the AI value-creation plan, then helps the portfolio deliver it. No hand-off between advisers, no drift between thesis and execution.</p>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1px;background:transparent;border:1px solid rgba(21,22,15,.16);--cell:1">
<a href="/ai-due-diligence" style="text-decoration:none;color:#15160f;background:#f5f2ea;outline:1px solid rgba(21,22,15,.16);padding:30px 26px;display:flex;flex-direction:column;gap:12px;min-height:250px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c">01 · PRE-DEAL</div><h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:26px;line-height:1.15">Tech, product &amp; AI due diligence</h3><p style="margin:0;font-size:15px;line-height:1.6;color:#3c3d33">What the platform is, whether the product earns the plan — and a costed AI plan of attack in the IC pack.</p><span style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;color:#8a5a3c">1–3 WEEKS · FIXED PRICE →</span></a>
<a href="/ai-operating-partner" style="text-decoration:none;color:#f5f2ea;background:#15160f;outline:1px solid rgba(21,22,15,.16);padding:30px 26px;display:flex;flex-direction:column;gap:12px;min-height:250px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#d9a27e">02 · PORTFOLIO</div><h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:26px;line-height:1.15">Fractional AI operating partner</h3><p style="margin:0;font-size:15px;line-height:1.6;color:#e4e1d6">Retained by the fund. AI value-creation plans across the portfolio, with the hands to deliver them.</p><span style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;color:#d9a27e">RETAINED · 2–4 DAYS/MONTH →</span></a>
<a href="/embedded-ai-delivery" style="text-decoration:none;color:#15160f;background:#f5f2ea;outline:1px solid rgba(21,22,15,.16);padding:30px 26px;display:flex;flex-direction:column;gap:12px;min-height:250px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c">03 · IN A PORTCO</div><h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:26px;line-height:1.15">Embedded AI delivery</h3><p style="margin:0;font-size:15px;line-height:1.6;color:#3c3d33">Inside one business, with its team. Internal tooling, automation and agents live in weeks.</p><span style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;color:#8a5a3c">2–8 WEEKS · FIXED PRICE →</span></a>
<a href="/board-and-ned" style="text-decoration:none;color:#15160f;background:#f5f2ea;outline:1px solid rgba(21,22,15,.16);padding:30px 26px;display:flex;flex-direction:column;gap:12px;min-height:250px"><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.18em;color:#8a5a3c">04 · GOVERNANCE</div><h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:26px;line-height:1.15">Board &amp; NED</h3><p style="margin:0;font-size:15px;line-height:1.6;color:#3c3d33">A small number of seats where technology, product and AI decide the outcome.</p><span style="margin-top:auto;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.12em;color:#8a5a3c">2–4 SEATS HELD →</span></a>
</div>
</div>

<div style="padding:clamp(46px,6vw,74px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);background:#eeeade;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(28px,4vw,60px)">
<div style="max-width:320px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:12px">II. FOR OPERATORS</div>
<h2 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:38px;line-height:1.1;letter-spacing:-.02em">Running the business, not backing it?</h2>
<p style="margin:16px 0 18px;font-size:15px;line-height:1.6;color:#5c5d51">The same AI practice, bought directly by CEOs and owner-managers who want cost out and capability in, without a transformation programme.</p>
<a href="/embedded-ai-delivery" style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-decoration:none;white-space:nowrap">THE AI PRACTICE FOR OPERATORS →</a>
</div>
<div style="grid-column:span 2;min-width:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px">
<div style="background:#f5f2ea;border:1px solid rgba(21,22,15,.14);padding:26px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px;margin-bottom:9px">“We know AI matters and don't know where to start.”</div><p style="margin:0;font-size:15px;line-height:1.6;color:#5c5d51">A ranked, costed plan your team can act on — written in a week, on site.</p></div>
<div style="background:#f5f2ea;border:1px solid rgba(21,22,15,.14);padding:26px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px;margin-bottom:9px">“Our cost is headcount doing repetitive work.”</div><p style="margin:0;font-size:15px;line-height:1.6;color:#5c5d51">Automation against the three worst hours-to-value processes, live inside two months.</p></div>
<div style="background:#f5f2ea;border:1px solid rgba(21,22,15,.14);padding:26px"><div style="font-family:'Newsreader',Georgia,serif;font-size:20px;margin-bottom:9px">“We bought the licences and nothing changed.”</div><p style="margin:0;font-size:15px;line-height:1.6;color:#5c5d51">Working alongside your people until the daily workflows are the ones with AI in them.</p></div>
</div>
</div>

<div style="padding:clamp(46px,6vw,74px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<div style="display:flex;justify-content:space-between;align-items:baseline;gap:20px;flex-wrap:wrap;margin-bottom:32px">
<div><div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:12px">III. RECENT WORK</div><h2 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:38px;line-height:1.1;letter-spacing:-.02em">What it looks like in practice</h2></div>
<a href="/track-record" style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-decoration:none;white-space:nowrap">FULL TRACK RECORD →</a>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
{cases.map((c) => (<Fragment>
<div style="border:1px solid rgba(21,22,15,.16);padding:30px 28px;display:flex;flex-direction:column;gap:14px;background:#f5f2ea">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#8a5a3c">{c.tag}</div>
<h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:24px;line-height:1.18">{c.title}</h3>
<p style="margin:0;font-size:15px;line-height:1.6;color:#3c3d33">{c.body}</p>
<div style="margin-top:auto;padding-top:18px;border-top:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:1fr 1fr;gap:16px">
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:30px;font-weight:300;letter-spacing:-.02em">{c.stat1}</div><div style="font-size:12.5px;color:#5c5d51;line-height:1.4">{c.label1}</div></div>
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:30px;font-weight:300;letter-spacing:-.02em">{c.stat2}</div><div style="font-size:12.5px;color:#5c5d51;line-height:1.4">{c.label2}</div></div>
</div>
</div>
</Fragment>))}
</div>
<p style="margin:18px 0 0;font-size:12.5px;color:#8a5a3c;font-family:'IBM Plex Mono',monospace;letter-spacing:.04em">Figures illustrative pending client sign-off — replace before publication.</p>
</div>

<div style="padding:clamp(46px,6vw,74px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);background:#eeeade;display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(28px,4vw,60px)">
<div style="max-width:300px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:12px">IV. INSIGHTS</div>
<h2 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:38px;line-height:1.1;letter-spacing:-.02em">Writing</h2>
<p style="margin:16px 0 18px;font-size:15px;line-height:1.6;color:#5c5d51">Short, practical pieces for deal teams and operators. No newsletter.</p>
<a href="/insights" style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-decoration:none;white-space:nowrap">ALL WRITING →</a>
</div>
<div style="grid-column:span 2;min-width:0">
{posts.map((p) => (<Fragment>
<a href={p.href} style="text-decoration:none;color:#15160f;display:grid;grid-template-columns:110px minmax(0,1fr);gap:22px;padding:20px 0;border-top:1px solid rgba(21,22,15,.18);align-items:baseline"><span style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#8a5a3c;letter-spacing:.1em">{p.kicker}</span><div><div style="font-family:'Newsreader',Georgia,serif;font-size:23px;margin-bottom:5px">{p.title}</div><div style="font-size:15px;line-height:1.55;color:#5c5d51">{p.standfirst}</div></div></a>
</Fragment>))}
</div>
</div>

<div style="padding:clamp(46px,6vw,74px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(28px,4vw,64px);align-items:start">
<div style="grid-column:span 2;min-width:0">
<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:12px">V. WHO YOU'RE HIRING</div>
<h2 style="margin:0 0 22px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:44px;line-height:1.08;letter-spacing:-.025em">Brannan Coady, and a bench</h2>
<p style="margin:0 0 16px;font-size:18px;line-height:1.68;color:#3c3d33;max-width:700px">I co-founded Netsells and ran it as chief executive through a decade of product work for Trainline, Coca-Cola, the BBC and Toolstation, to a merger with hedgehog lab backed by BGF. I've been Chief Product Officer and an executive director at YourParkingSpace, and I've invested in, advised and sat on the boards of UK software and consumer businesses — with exits to FTSE 100 acquirers.</p>
<p style="margin:0 0 22px;font-size:18px;line-height:1.68;color:#3c3d33;max-width:700px">I lead every engagement personally. When the work needs more hands, I bring in senior engineers, designers and security specialists I've shipped with for years.</p>
<a href="/brannan-coady" style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;letter-spacing:.14em;text-decoration:none;white-space:nowrap">THE LONGER VERSION →</a>
</div>
<Portrait style="max-width:340px;width:100%" />
</div>
</div>
</Base>
