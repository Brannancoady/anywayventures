---
import Base from '../layouts/Base.astro';
import { cases, peServices, dont, updatedLabel } from '../lib/data';

const path = '/private-equity';
const updated = updatedLabel(path);
---
<Base path={path}>
<div>
<div style="padding:clamp(48px,7vw,80px) clamp(20px,4vw,60px) clamp(40px,5vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<div style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:30px"><div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.2em;color:#8a5a3c">FOR PRIVATE EQUITY, GROWTH INVESTORS &amp; ACQUIRERS</div><div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.14em;color:#5c5d51">LAST UPDATED {updated}</div></div>
<h1 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:clamp(38px,5.4vw,72px);line-height:1.04;letter-spacing:-.025em;max-width:18ch;text-wrap:balance">Technology and AI judgement <em style="color:#8a5a3c">across the whole hold</em>.</h1>
<div style="display:flex;flex-direction:column;gap:30px;margin-top:40px;align-items:flex-start">
<p style="margin:0;font-size:19px;line-height:1.62;color:#3c3d33;max-width:700px;text-wrap:pretty">Most funds buy technology diligence from one firm, an AI strategy from another, and then ask the portfolio company to deliver it alone. We do the three as one continuous piece of work — by the person who has run, built and sold the kind of business you own.</p>
<div style="display:flex;flex-wrap:wrap;gap:12px 22px;align-items:center;align-self:stretch">
<a href="/contact" style="flex:none;white-space:nowrap;text-decoration:none;background:#15160f;color:#f5f2ea;padding:14px 24px;min-height:48px;display:inline-flex;align-items:center;font-size:15px;font-weight:500">Book 30 minutes</a>
<span style="font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:#5c5d51">FREE · ONE CALL FOR EVERY ENQUIRY · STRAIGHT ANSWER ON FIT</span>
</div>
</div>
</div>

<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<h2 style="margin:0 0 8px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:38px;letter-spacing:-.02em">Four services, one deal cycle</h2>
<p style="margin:0 0 36px;font-size:16px;color:#5c5d51;max-width:640px">Enter at any point. Most relationships start with a diligence and become a retained operating-partner role.</p>
<div style="display:flex;flex-direction:column">
{peServices.map((s) => (<Fragment>
<a class="r-svc" href={s.href} style="text-decoration:none;color:#15160f;display:grid;gap:16px 24px;padding:26px 0;border-top:1px solid rgba(21,22,15,.18);align-items:start"><span style="font-family:'IBM Plex Mono',monospace;font-size:12px;color:#8a5a3c">{s.n}</span><div style="font-family:'Newsreader',Georgia,serif;font-size:26px;line-height:1.15">{s.title}</div><p style="margin:0;font-size:15.5px;line-height:1.6;color:#3c3d33">{s.body}</p><span class="r-time" style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#5c5d51;letter-spacing:.1em">{s.meta}</span></a>
</Fragment>))}
<div style="border-top:1px solid rgba(21,22,15,.18)"></div>
</div>
</div>

<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);background:#eeeade">
<h2 style="margin:0 0 30px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:36px;letter-spacing:-.02em">Why funds use us</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:34px">
<div style="border-top:2px solid #8a5a3c;padding-top:18px"><h3 style="margin:0 0 9px;font-size:19px;font-weight:600">Operator, not analyst</h3><p style="margin:0;font-size:15.5px;line-height:1.62;color:#3c3d33">Ran a product business for a decade, sold it, sat on the buy side. The report reads like it was written by someone who has had to live with the consequences.</p></div>
<div style="border-top:2px solid rgba(21,22,15,.25);padding-top:18px"><h3 style="margin:0 0 9px;font-size:19px;font-weight:600">Continuity</h3><p style="margin:0;font-size:15.5px;line-height:1.62;color:#3c3d33">The diligence author writes the value-creation plan and can help deliver it. Nothing gets lost between advisers.</p></div>
<div style="border-top:2px solid rgba(21,22,15,.25);padding-top:18px"><h3 style="margin:0 0 9px;font-size:19px;font-weight:600">Still building</h3><p style="margin:0;font-size:15.5px;line-height:1.62;color:#3c3d33">Hands on the current AI tooling every week. The plan reflects what actually works in production now, not what a vendor deck says.</p></div>
<div style="border-top:2px solid rgba(21,22,15,.25);padding-top:18px"><h3 style="margin:0 0 9px;font-size:19px;font-weight:600">Fixed price, deal timetable</h3><p style="margin:0;font-size:15.5px;line-height:1.62;color:#3c3d33">Quoted the same week, delivered to your exclusivity window. No day rates, no scope drift.</p></div>
</div>
</div>

<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:clamp(28px,4vw,60px)">
<div style="max-width:320px"><div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:.18em;color:#8a5a3c;margin-bottom:12px">THE ANTI-OFFER</div><h2 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:36px;letter-spacing:-.02em;line-height:1.1">What we don't do</h2><p style="margin:16px 0 0;font-size:15px;line-height:1.6;color:#5c5d51">Saying no to these is most of what makes the rest work.</p></div>
<div style="grid-column:span 2;min-width:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:0 36px">
{dont.map((d) => (<Fragment>
<div style="padding:16px 0;border-top:1px solid rgba(21,22,15,.16);display:grid;grid-template-columns:22px minmax(0,1fr);gap:12px;align-items:start"><span style="font-family:'IBM Plex Mono',monospace;font-size:14px;color:#8a5a3c;line-height:1.4">×</span><div><div style="font-size:16.5px;font-weight:600;margin-bottom:3px">{d.t}</div><div style="font-size:14.5px;line-height:1.55;color:#3c3d33">{d.b}</div></div></div>
</Fragment>))}
</div>
</div>
<div style="padding:clamp(46px,6vw,70px) clamp(20px,4vw,60px);border-bottom:1px solid rgba(21,22,15,.14)">
<h2 style="margin:0 0 30px;font-family:'Newsreader',Georgia,serif;font-weight:300;font-size:36px;letter-spacing:-.02em">Recent work</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:24px">
{cases.map((c) => (<Fragment>
<div style="border:1px solid rgba(21,22,15,.16);padding:30px 28px;display:flex;flex-direction:column;gap:14px">
<div style="font-family:'IBM Plex Mono',monospace;font-size:10.5px;letter-spacing:.16em;color:#8a5a3c">{c.tag}</div>
<h3 style="margin:0;font-family:'Newsreader',Georgia,serif;font-weight:400;font-size:24px;line-height:1.18">{c.title}</h3>
<p style="margin:0;font-size:15px;line-height:1.6;color:#3c3d33">{c.body}</p>
<div style="margin-top:auto;padding-top:18px;border-top:1px solid rgba(21,22,15,.14);display:grid;grid-template-columns:1fr 1fr;gap:16px">
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:30px;font-weight:300;letter-spacing:-.02em">{c.stat1}</div><div style="font-size:12.5px;color:#5c5d51;line-height:1.4">{c.label1}</div></div>
<div><div style="font-family:'Newsreader',Georgia,serif;font-size:30px;font-weight:300;letter-spacing:-.02em">{c.stat2}</div><div style="font-size:12.5px;color:#5c5d51;line-height:1.4">{c.label2}</div></div>
</div>
</div>
</Fragment>))}
</div>
</div>
</div>
</Base>
